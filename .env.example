# Copiar a .env y completar. .env está en .gitignore.

# --- Backend (services/weather-api) ---
PORT=8080
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
# Cada cuántos segundos el backend vuelve a consultar y empuja por WebSocket
WEATHER_REFRESH_SECONDS=600
REDIS_URL=redis://redis:6379
CACHE_TTL_SECONDS=600

# --- MCP en Cursor (se leen del entorno del sistema, no de este archivo) ---
# GITHUB_PERSONAL_ACCESS_TOKEN=
